        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

//Description: 
//Transfer the WorkNotes text entered in the related INC to the Parent Problem number.


	var gr = new GlideRecord('problem');
	gr.addQuery('sys_id', current.problem_id);
	gr.query();
	if (gr.next()) {
		gr.work_notes = current.work_notes.getJournalEntry(1) + "\nWork Notes captured from: " + current.number;
	}
	gr.update();

})(current, previous);]]></script>
