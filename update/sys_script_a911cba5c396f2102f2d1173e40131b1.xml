        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	//Description:
	//Increment the count of the Associate Incident Count field whenever a new INC is linked to the parent PRB Number.

	var gr = new GlideRecord('problem');
	gr.addQuery('sys_id', current.problem_id);
	gr.query();
	if (gr.next()) {
		gr.x_58872_needit_associate_incident_count = gr.x_58872_needit_associate_incident_count + 1;
	}
	gr.update();

})(current, previous);]]></script>
