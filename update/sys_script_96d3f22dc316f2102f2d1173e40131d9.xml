        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {


	//Description:
	//Create 2 types of Problem Task whenever a Problem is set to Priority = 1-Critical.

	var type = ['General', 'Root Cause Analysis'];
	for (i = 0; i < 2; i++) {
		var gr = new GlideRecord('problem_task');
		gr.initialize();
		gr.problem_task_type = type[i];
		gr.short_description = 'Task type of ' + type[i];
		gr.problem = current.sys_id;
		gr.insert();

	}

})(current, previous);]]></script>
